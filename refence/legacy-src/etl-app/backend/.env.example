# ETL 后端环境变量配置示例
# 复制此文件为 .env 并修改配置

# ==================== 系统配置 ====================

# 时区（东八区）
TZ=Asia/Shanghai

# 加密密钥（用于加密 MySQL 密码等敏感数据）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# JWT 密钥（如果需要认证功能）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# ==================== 数据库配置 ====================

# SQLite 配置数据库路径
ETL_CFG_DB_PATH=ETL/backend/data/etl_config.sqlite

# ==================== 应用配置 ====================

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# ==================== 注意事项 ====================

# 1. 首次启动时，必须配置 ENCRYPTION_KEY
# 2. 生产环境必须修改默认密钥
# 3. MySQL 连接配置存储在 SQLite 中，通过 Web 界面管理
# 4. 此文件不应提交到版本控制系统
