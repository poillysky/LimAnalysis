APP_NAME=LimAnalysis API
API_PREFIX=/api/v1
# 开发：Vite 8848；车间用 IP 访问时把前端地址加进来，逗号分隔
CORS_ORIGINS=http://localhost:8848,http://127.0.0.1:8848

# 空则使用仓库 data/meta/lim_meta.sqlite
META_SQLITE_PATH=

# 本地 docker compose 默认；NAS 见 deploy/docker-compose.nas.yml（15432/15433/15434）
# 前端「连接管理」写入 meta 后优先生效，会覆盖下面地址
RAW_DATABASE_URL=postgresql+psycopg://lim:lim@127.0.0.1:5432/lim_raw
DWH_DATABASE_URL=postgresql+psycopg://lim:lim@127.0.0.1:5433/lim_dwh
DEFECT_DATABASE_URL=postgresql+psycopg://lim:lim@127.0.0.1:5434/lim_defect

# 车间离线值守：true=停 SFC 定时采集、禁止 AI 外网调用（见 deploy/workshop）
WORKSHOP_OFFLINE=false
