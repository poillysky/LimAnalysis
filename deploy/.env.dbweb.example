# 复制为 deploy/.env.dbweb 后按需修改
# docker compose --env-file .env.dbweb -f docker-compose.dbweb.yml up -d

# 若用 docker-compose.nas.yml：Adminer 已在其中，端口 18080
# 前端外部连接 / VITE_DBWEB_URL 填：http://<NAS>:18080

# 仅单独起 Adminer（docker-compose.dbweb.yml）时用下面变量
DBWEB_PORT=18080
ADMINER_DEFAULT_SERVER=192.168.2.38:15432
