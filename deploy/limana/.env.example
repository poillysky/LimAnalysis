# 复制为 /vol1/1000/Docker/limana/.env
# cp deploy/limana/.env.example /vol1/1000/Docker/limana/.env

COMPOSE_PROJECT_NAME=limana

# Docker Hub 镜像
DOCKERHUB_USER=poillysky
IMAGE_TAG=V1.0.0

# 应用数据根（meta / raw / photos / nginx-web.conf）
DATA_ROOT=/vol1/1000/Docker/limana

# 对外端口（仅应用）
WEB_PORT=8080
API_PORT=8000

# 已有 Postgres（docker-compose.nas.yml 对外端口）
# Linux NAS 一般用 host.docker.internal（compose 已配 host-gateway）
# 若不通，改成 NAS 局域网 IP，如 192.168.1.10
PG_HOST=host.docker.internal
PG_RAW_PORT=15432
PG_DWH_PORT=15433
PG_DEFECT_PORT=15434
POSTGRES_USER=lim
POSTGRES_PASSWORD=lim

# 前端访问地址（CORS，逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# 车间离线
WORKSHOP_OFFLINE=true
